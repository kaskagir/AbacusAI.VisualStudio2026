        <Strings>
          <ButtonText>Abacus: Explain Selection</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidAbacusCmdSet" id="cmdidFixSelection" priority="0x0103" type="Button">
        <Parent guid="guidAbacusCmdSet" id="grpidCodeWin"/>
        <Strings>
          <ButtonText>Abacus: Fix Selection</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>
  <Symbols>
    <GuidSymbol name="guidAbacusPackage" value="{8D3C0C9E-8B3E-4E0D-9B53-9A4D6D7D1C01}" />
